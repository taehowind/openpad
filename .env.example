# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Signs the session cookies. Must be at least 32 characters; the app refuses to start in
# production with anything shorter. Generate one with:  openssl rand -base64 36
SESSION_SECRET=replace-with-at-least-32-random-characters

# The first super-admin, created on first start if no admin exists yet. Other instructors sign
# up themselves and are approved from the member screen.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-separate-admin-password


# ---------------------------------------------------------------------------
# Storage — pick ONE of the two setups below
# ---------------------------------------------------------------------------

# A) Self-hosting (default). A SQLite file and an uploads directory, both on a persistent
#    volume. Nothing else to configure.
SQLITE_PATH=/data/aistudy.sqlite
UPLOAD_DIR=/data/uploads

# B) Vercel + Supabase. Set these instead and the app switches to Postgres and object storage.
#    Serverless has no durable filesystem, so the two go together.
#
# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler".
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# Supabase -> Project Settings -> API. The service role key is a server-side secret: it bypasses
# row-level security, so never expose it to the browser and never commit it.
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service-role-key
#
# Create this bucket in Supabase -> Storage first. Keep it PRIVATE; the app streams files
# through its own permission checks and never links to the bucket directly.
# SUPABASE_STORAGE_BUCKET=uploads


# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Set to 1 when several instances serve the app behind a load balancer. Vercel sets VERCEL=1
# itself, so this is only for self-hosted multi-instance setups. It turns off push-based live
# updates (they cannot cross instances, so clients poll instead) and moves the login rate
# limiter into the database, so the limits are not multiplied by the instance count.
# SERVERLESS=1

# Postgres connections per instance. Keep it small on serverless.
# PGPOOL_MAX=4
